# Houston-backed beads: .beads/ is local machine state (a pointer at the
# central Dolt gateway plus this clone's credential), never repository content.
# Added by `houston beads init`.
.beads/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
.cache/linear/
.cache/

# Serena code-intelligence state: per-machine cache, local config and memories
.serena/
